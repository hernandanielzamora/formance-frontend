# Copiar las variables necesarias a formance-frontend/.env.e4.local (ignorado).
E4_BASE_URL=http://localhost:3000
E4_DEMO_WEEK_START=2026-10-05
# Alternativa al login Google manual: no son obligatorias si existe .auth/e4.json.
E4_DEMO_EMAIL=
